{
  "version": 6,
  "configurePresets": [
    {
      "name": "host",
      "displayName": "macOS, Homebrew GCC 16",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/opt/homebrew/bin/g++-16",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux GCC 16 (docker gcc:16.2)",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "tsan",
      "displayName": "Linux GCC 16 with ThreadSanitizer (Homebrew GCC on macOS ships no libtsan)",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "REFLECT_MOC_TSAN": "ON"
      }
    },
    {
      "name": "qt",
      "displayName": "Linux GCC 16 with the Qt layer (the reflect-moc/gcc16-qt610 image)",
      "inherits": "linux",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/qt",
      "cacheVariables": {
        "RQT_BUILD_QT": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "host", "configurePreset": "host" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "qt", "configurePreset": "qt" }
  ],
  "testPresets": [
    { "name": "host", "configurePreset": "host", "output": { "outputOnFailure": true } },
    { "name": "linux", "configurePreset": "linux", "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } },
    {
      "name": "qt",
      "configurePreset": "qt",
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 900 }
    }
  ]
}
